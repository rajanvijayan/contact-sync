{
  "name": "contact-sync",
  "version": "1.0.0",
  "private": true,
  "description": "Lead capture portal with Microsoft Dynamics 365 synchronisation.",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "wp-scripts build portal=./src/portal/index.js admin=./src/admin/index.js",
    "start": "wp-scripts start portal=./src/portal/index.js admin=./src/admin/index.js",
    "lint:js": "wp-scripts lint-js src tests/js",
    "lint:css": "wp-scripts lint-style \"src/**/*.scss\"",
    "test": "wp-scripts test-unit-js --config jest.config.js",
    "make-pot": "wp i18n make-pot . languages/contact-sync.pot --exclude=node_modules,vendor,src,tests",
    "zip": "bash bin/build-zip.sh"
  },
  "devDependencies": {
    "@wordpress/scripts": "^30.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "papaparse": "^5.4.1"
  }
}
